{
  "schemaVersion": 1,
  "runtimeRoot": "runtime/ubuntu-stack",
  "prerequisites": [
    {
      "name": "Node.js",
      "commands": [
        "node",
        "npm"
      ]
    },
    {
      "name": "Corepack pnpm for Dify web",
      "commands": [
        "corepack"
      ]
    },
    {
      "name": "uv for Dify/RAGFlow Python services",
      "commands": [
        "uv"
      ]
    },
    {
      "name": "Python",
      "commands": [
        "python3"
      ]
    },
    {
      "name": "jq for parsing json",
      "commands": [
        "jq"
      ]
    }
  ],
  "services": [
    {
      "name": "redis",
      "enabled": true,
      "description": "Native Redis via apt-get.",
      "workingDirectory": ".",
      "command": "redis-server",
      "arguments": [
        "--port",
        "6379",
        "--bind",
        "127.0.0.1",
        "--save",
        "",
        "--appendonly",
        "no"
      ],
      "port": 6379,
      "startupTimeoutSeconds": 15
    },
    {
      "name": "postgres",
      "enabled": true,
      "description": "Native Postgres for Dify. Initialize the data directory and dify database before enabling.",
      "workingDirectory": ".",
      "command": "bash",
      "arguments": [
        "-c",
        "PG_VER=$(ls /usr/lib/postgresql/ | sort -n | tail -1); su postgres -c \"/usr/lib/postgresql/$PG_VER/bin/postgres -D $(pwd)/runtime/ubuntu-stack/data/postgres -p 5433\""
      ],
      "port": 5433,
      "startupTimeoutSeconds": 60
    },
    {
      "name": "qdrant",
      "enabled": true,
      "description": "Qdrant vector store for Dify. Run install-middleware.sh --qdrant first. Set VECTOR_STORE=qdrant and QDRANT_URL=http://127.0.0.1:6333 in runtime/dify/api/.env.",
      "workingDirectory": "runtime/ubuntu-stack/data",
      "command": "../bin/qdrant/qdrant",
      "arguments": [
        "--disable-telemetry"
      ],
      "port": 6333,
      "startupTimeoutSeconds": 30
    },
    {
      "name": "dify-api",
      "enabled": true,
      "description": "Dify Flask API. Requires uv and configured api/.env.",
      "workingDirectory": "runtime/dify/api",
      "command": "bash",
      "arguments": [
        "-c",
        "uv run flask db upgrade && uv run flask run --host 127.0.0.1 --port 5001 --debug"
      ],
      "port": 5001,
      "startupTimeoutSeconds": 90
    },
    {
      "name": "dify-plugin-daemon",
      "enabled": true,
      "description": "Dify Plugin Daemon for v0.14+. Requires .env at runtime/ubuntu-stack/plugin-daemon.env (auto-generated by configure-dify-env.sh).",
      "workingDirectory": ".",
      "command": "bash",
      "arguments": [
        "-c",
        "set -a && source runtime/ubuntu-stack/plugin-daemon.env && set +a && runtime/ubuntu-stack/bin/plugin-daemon/plugin-daemon-cli migrate && exec runtime/ubuntu-stack/bin/plugin-daemon/plugin-daemon-server"
      ],
      "port": 5002,
      "startupTimeoutSeconds": 60
    },
    {
      "name": "dify-web",
      "enabled": true,
      "description": "Dify Next.js web app. Requires pnpm and web/.env.local.",
      "workingDirectory": "runtime/dify/web",
      "command": "bash",
      "arguments": [
        "-c",
        "PORT=3001 exec corepack pnpm start"
      ],
      "port": 3001,
      "startupTimeoutSeconds": 600
    },
    {
      "name": "mysql",
      "enabled": false,
      "description": "Disabled: uses system MySQL (port 3306) via systemd. Run: sudo systemctl start mysql",
      "workingDirectory": ".",
      "command": "bash",
      "arguments": [
        "-c",
        "mysqld --datadir=$(pwd)/runtime/ubuntu-stack/data/mysql --port=3307 --user=mysql"
      ],
      "port": 3307,
      "startupTimeoutSeconds": 60
    },
    {
      "name": "elasticsearch",
      "enabled": true,
      "description": "Elasticsearch 8.11.3 for RAGFlow.",
      "workingDirectory": ".",
      "command": "bash",
      "arguments": [
        "-c",
        "chown -R daemon:daemon $(pwd)/runtime/ubuntu-stack/bin/elasticsearch && su daemon -s /bin/bash -c \"ES_JAVA_OPTS='-Xms1g -Xmx1g' $(pwd)/runtime/ubuntu-stack/bin/elasticsearch/bin/elasticsearch -Ehttp.port=1200 -Ediscovery.type=single-node -Expack.security.enabled=false -Expack.security.http.ssl.enabled=false -Expack.security.transport.ssl.enabled=false\""
      ],
      "port": 1200,
      "startupTimeoutSeconds": 120
    },
    {
      "name": "minio",
      "enabled": true,
      "description": "Native MinIO object storage for RAGFlow.",
      "workingDirectory": ".",
      "command": "runtime/ubuntu-stack/bin/minio/minio",
      "arguments": [
        "server",
        "runtime/ubuntu-stack/data/minio",
        "--console-address",
        ":9001"
      ],
      "port": 9000,
      "startupTimeoutSeconds": 30
    },
    {
      "name": "ragflow-api",
      "enabled": true,
      "description": "RAGFlow API server from source.",
      "workingDirectory": "runtime/ragflow",
      "command": "bash",
      "arguments": [
        "-c",
        "PYTHONPATH=$(pwd) uv run python api/ragflow_server.py"
      ],
      "port": 9380,
      "startupTimeoutSeconds": 120
    },
    {
      "name": "ragflow-worker",
      "enabled": true,
      "description": "RAGFlow task executor from source.",
      "workingDirectory": "runtime/ragflow",
      "command": "bash",
      "arguments": [
        "-c",
        "PYTHONPATH=$(pwd) uv run python rag/svr/task_executor.py 0"
      ],
      "port": 0,
      "startupTimeoutSeconds": 15
    },
    {
      "name": "ragflow-web",
      "enabled": true,
      "description": "RAGFlow Vite web app.",
      "workingDirectory": "runtime/ragflow/web",
      "command": "bash",
      "arguments": [
        "-c",
        "npx vite preview --host 127.0.0.1 --port 8080"
      ],
      "port": 8080,
      "startupTimeoutSeconds": 300
    },
    {
      "name": "chatbot-frontend",
      "enabled": true,
      "description": "Custom Next.js Chatbot Frontend.",
      "workingDirectory": "frontend",
      "command": "bash",
      "arguments": [
        "-c",
        "npm run start -- --port 3000"
      ],
      "port": 3000,
      "startupTimeoutSeconds": 90
    }
  ],
  "clean": {
    "logGlobs": [
      "runtime/ubuntu-stack/logs/*"
    ],
    "cacheGlobs": [
      "runtime/ubuntu-stack/tmp/*"
    ],
    "dataGlobs": [
      "runtime/ubuntu-stack/data/*"
    ]
  }
}