# Required: 32+ random chars to sign JWT session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-plus-random-bytes-base64

# Dify Brain layer — trỏ vào Dify API trên cùng server.
# Trên Ubuntu server: http://127.0.0.1:5001
DIFY_BASE_URL=http://127.0.0.1:5001

# Lấy từ Dify UI: Studio → App → API Access → API Key
# Set sau khi tạo Chatflow xong.
DIFY_API_KEY=

# Set "false" khi đã cấu hình Dify xong. "true" = mock mode (UI dev).
DIFY_USE_MOCK=false
