# Required: 32+ random chars to sign JWT session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-plus-random-bytes-base64

# Dify Brain layer. Leave blank to force mock mode.
DIFY_BASE_URL=
DIFY_API_KEY=

# Force mock streaming even when DIFY_BASE_URL/DIFY_API_KEY are set.
# Useful for offline UI dev. Set to "true" to enable.
DIFY_USE_MOCK=true
